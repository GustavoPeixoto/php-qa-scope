#!/usr/bin/env python3
"""Wait for the extension's Codex executable, then delegate setup to upstream."""

import argparse
import os
import subprocess
import sys
import time


def positive_seconds(value):
    seconds = int(value)
    if seconds <= 0:
        raise argparse.ArgumentTypeError("seconds must be a positive integer")
    return seconds


def codex_ready(wait_seconds=None):
    """Retry only absent executables/launcher 127, within a monotonic deadline."""
    deadline = time.monotonic() + wait_seconds if wait_seconds is not None else None
    detail = "codex executable is not on PATH"
    announced = False
    while True:
        remaining = deadline - time.monotonic() if deadline is not None else 5
        if remaining <= 0:
            raise RuntimeError(f"Codex was not available within {wait_seconds}s: {detail}. "
                               "Check the openai.chatgpt extension installation, then reconnect "
                               "or run setup-codex-context-mode --wait-for-codex 180 again.")
        try:
            result = subprocess.run(["codex", "--version"], capture_output=True, text=True,
                                    timeout=min(5, remaining))
        except FileNotFoundError:
            result = None
            detail = "codex executable is not on PATH"
        except subprocess.TimeoutExpired as error:
            raise RuntimeError("codex --version timed out: " +
                               str(error.stderr or error.stdout or "no diagnostic")) from error
        if result is not None:
            detail = result.stderr.strip() or result.stdout.strip() or "no diagnostic"
            if result.returncode == 0:
                return
            if result.returncode != 127:
                raise RuntimeError(f"codex --version exited {result.returncode}: {detail}")
        if deadline is None:
            raise RuntimeError(f"Codex is unavailable: {detail}")
        if not announced:
            print(f"Waiting up to {wait_seconds}s for the openai.chatgpt extension's Codex binary...",
                  flush=True)
            announced = True
        time.sleep(min(2, max(0, deadline - time.monotonic())))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--wait-for-codex", type=positive_seconds, metavar="SECONDS",
                        help="wait for the extension binary before official setup")
    args = parser.parse_args()
    codex_ready(args.wait_for_codex)
    os.execvp("context-mode", ["context-mode", "setup", "--yes", "--agents", "codex"])


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        print(f"setup-codex-context-mode: {error}", file=sys.stderr)
        sys.exit(1)
