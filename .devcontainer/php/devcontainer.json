{
  "name": "${localWorkspaceFolderBasename}-php",
  "dockerComposeFile": [
    "../../docker-compose.yml"
  ],
  "service": "php",
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "overrideCommand": true,
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "42crunch.vscode-openapi",
        "desmondhiew.singular-plural",
        "devsense.composer-php-vscode",
        "DEVSENSE.phptools-vscode",
        "ecodes.vscode-phpmd",
        "EditorConfig.EditorConfig",
        "george-alisson.html-preview-vscode",
        "inferrinizzard.prettier-sql-vscode",
        "junstyle.php-cs-fixer",
        "mechatroner.rainbow-csv",
        "redhat.vscode-yaml",
        "sanderronde.phpstan-vscode",
        "tamasfe.even-better-toml",
        "valeryanm.vscode-phpsab",
        "wmaurer.change-case",
        "xdebug.php-debug"
      ],
      "settings": {
        "[json]": {
          "editor.defaultFormatter": "vscode.json-language-features"
        },
        "[php]": {
          "editor.defaultFormatter": "junstyle.php-cs-fixer",
          "editor.formatOnSave": true
        },
        "editor.find.loop": false,
        "files.associations": {
          "*.ini-development": "ini"
        },
        "php.version": "8.5",
        "php.validate.enable": false,
        "php.problems.scope": "none",
        "php.problems.exclude": {
          "**": true
        },
        "php-cs-fixer.executablePath": "${containerEnv:WORKSPACE_DIR}/vendor/bin/php-cs-fixer",
        "php-cs-fixer.config": "${containerEnv:WORKSPACE_DIR}/php-cs-fixer.dist.php",
        "php-cs-fixer.tmpDir": "${containerEnv:WORKSPACE_DIR}/tmp/cs-fixer",
        "php-cs-fixer.onsave": true,
        "phpsab.excludeGlobs": [
          "**/vendor/**"
        ],
        "phpsab.snifferMode": "onType",
        "remote.autoForwardPorts": false,
        "remote.portsAttributes": {
          "9003": {
            "label": "Xdebug",
            "onAutoForward": "silent"
          }
        },
        "workbench.colorCustomizations": {
          "titleBar.activeBackground": "#34345F",
          "titleBar.activeForeground": "#F3F2FF",
          "titleBar.inactiveBackground": "#20213B",
          "titleBar.inactiveForeground": "#A9A8CC",
          "editor.background": "#101214",
          "sideBar.background": "#161722",
          "activityBar.background": "#202044",
          "activityBar.activeBorder": "#777BB4"
        }
      }
    }
  },
  "remoteUser": "dev"
}
