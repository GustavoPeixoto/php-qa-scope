{
    "name": "gustavo-peixoto/php-qa-scope",
    "type": "library",
    "description": "Synchronize managed PHP QA scope blocks across PHP QA tool configuration files.",
    "license": "MIT",
    "bin": [
        "bin/php-qa-scope"
    ],
    "autoload": {
        "psr-4": {
            "GustavoPeixoto\\PhpQaScope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GustavoPeixoto\\PhpQaScope\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "GustavoPeixoto"
        }
    ],
    "minimum-stability": "dev",
    "scripts": {
        "sniffer-check": "phpcs --colors -p",
        "sniffer-fix": "phpcbf --colors -p",
        "fixer-check": "php-cs-fixer fix --config=php-cs-fixer.dist.php --dry-run --diff",
        "fixer-fix": "php-cs-fixer fix --config=php-cs-fixer.dist.php",
        "stan-check": "phpstan analyse",
        "php-qa-scope": "@php bin/php-qa-scope"
    },
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.2",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
