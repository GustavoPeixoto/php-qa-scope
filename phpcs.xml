<?xml version="1.0"?>
<ruleset name="App">
    <description>Coding standards</description>

    <!-- php-qa-scope:start -->
    <file>.</file>
    <arg name="extensions" value="php"/>
    <exclude-pattern type="relative">(?-i)^(?!(?:bin(?:/|$)|src(?:/|$)|tests(?:/|$))).+</exclude-pattern>
    <exclude-pattern type="relative">(?-i)^(?!(?:bin(?:/|$)|src(?:/|$)|tests(?:/|$))).+/*</exclude-pattern>
    <exclude-pattern type="relative">(?-i)^(?:[^/]+/){0,}\.[^/]+/*</exclude-pattern>
    <!-- php-qa-scope:end -->

    <rule ref="PSR12"/>

</ruleset>
