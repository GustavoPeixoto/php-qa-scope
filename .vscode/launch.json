  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug",
      "type": "php",
      "request": "launch",
      "port": 9003
    },
    {
      "name": "php-qa-scope check",
      "type": "php",
      "request": "launch",
      "program": "${workspaceFolder}/bin/php-qa-scope",
      "args": [
        "check"
      ],
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "php"
    },
    {
      "name": "php-qa-scope sync",
      "type": "php",
      "request": "launch",
      "program": "${workspaceFolder}/bin/php-qa-scope",
      "args": [
        "sync"
      ],
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "php"
    }
  ]
}